{
  "endOfLine": "auto",
  "importOrder": ["<THIRD_PARTY_MODULES>", "ag-grid.*\\.css$", ".*\\.scss$", "@mantine.*\\.css$"],
  "importOrderSeparation": true,
  "importOrderSortSpecifiers": true,
  "jsxSingleQuote": true,
  "plugins": ["@trivago/prettier-plugin-sort-imports"],
  "printWidth": 160,
  "semi": true,
  "singleQuote": true,
  "tabWidth": 2,
  "trailingComma": "none"
}
